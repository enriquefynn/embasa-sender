# SMTP account used to send the bills
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=app-password-here
SMTP_FROM=you@gmail.com
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls

# Daily check time (HH:MM) in TZ, and whether to also check when the container starts
RUN_AT=08:00
TZ=America/Bahia
RUN_ON_START=true
LOG_LEVEL=INFO
